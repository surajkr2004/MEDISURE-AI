# ==============================================================================
# MediSure AI — Root Environment Configuration Template
# Deployment: GitHub + Vercel + Supabase (Free Tier)
# ==============================================================================

# Supabase PostgreSQL & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Fast-API Backend Secret (For local Python development)
SECRET_KEY=generate-a-secure-random-secret-key-32-chars-min
DATABASE_URL=sqlite:///./medisure.db
# To connect FastAPI to Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# Application Settings
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
